    "id": null,
    "links": [],
    "liveNow": false,
    "panels": [
        {
            "title": "Real-Time Active WebSocket Connections (Negotiation Mesh)",
            "type": "stat",
            "gridPos": {
                "h": 8,
                "w": 6,
                "x": 0,
                "y": 0
            },
            "targets": [
                {
                    "expr": "sum(ahmedbaba_gateway_active_connections)",
                    "refId": "A"
                }
            ],
            "options": {
                "colorMode": "value",
                "graphMode": "area",
                "justifyMode": "auto"
            }
        },
        {
            "title": "API Gateway Request Latency (ms) - /v1/products/:id",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 6,
                "y": 0
            },
            "targets": [
                {
                    "expr": "histogram_quantile(0.95, sum(rate(ahmedbaba_http_request_duration_ms_bucket[5m])) by (le))",
                    "legendFormat": "P95 Latency"
                }
            ]
        },
        {
            "title": "Active Kubernetes Pods (HPA Cluster State)",
            "type": "gauge",
            "gridPos": {
                "h": 8,
                "w": 6,
                "x": 18,
                "y": 0
            },
            "targets": [
                {
                    "expr": "kube_deployment_status_replicas_available{deployment='ahmedbaba-api-gateway'}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "min": 3,
                    "max": 30,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "red",
                                "value": 25
                            }
                        ]
                    }
                }
            }
        },
        {
            "title": "Database Connection Pool Saturation",
            "type": "bar_gauge",
            "gridPos": {
                "h": 8,
                "w": 24,
                "x": 0,
                "y": 8
            },
            "targets": [
                {
                    "expr": "sum(pg_stat_activity_count) by (datname) / pg_settings_max_connections"
                }
            ],
            "options": {
                "displayMode": "lcd",
                "orientation": "horizontal"
            }
        }
    ],
